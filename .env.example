# Backend: export values in your shell or use Render environment settings.
# Leave DATABASE_URL unset for deterministic, credential-free fixtures.
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional; omit to evaluate freshness against today's date.
AS_OF_DATE=2026-10-14
# Server-only, optional. Never use VITE_ for credentials.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
AI_DAILY_CALL_LIMIT=20
# Frontend Render setting (omit locally: Vite proxies to port 8000).
VITE_API_URL=
